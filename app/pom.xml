<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.ghosthack.microhm</groupId>
    <artifactId>micro-harness-manager-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>microhm-app</artifactId>
  <description>The Swing app: sidebar, terminals, harness plugins, MCP session controller.</description>

  <properties>
    <mainClass>io.github.ghosthack.microhm.app.MicroHarnessManagerApp</mainClass>
  </properties>

  <dependencies>
    <!-- The session daemon and its client. Compile scope: SessionServerHost talks to it
         in-process, and the shaded jar carries the daemon itself (the client's
         ServerLauncher starts its Main from this same class path). -->
    <dependency>
      <groupId>io.github.ghosthack.microhm</groupId>
      <artifactId>microhm-mux</artifactId>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>3.6</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- argLine (MacWindowAppearance binds the Objective-C runtime through the FFM
             API) comes from the parent's pluginManagement. -->
        <configuration>
          <!-- A backstop: a test that forgets its own temp dir still never reads or
               writes the user's ~/.micro-harness-manager (registry, settings, daemon). -->
          <systemPropertyVariables>
            <microhm.registry>${project.build.directory}/test-state/sessions.json</microhm.registry>
            <microhm.mux.home>${project.build.directory}/test-state/mux</microhm.mux.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${mainClass}</mainClass>
                  <manifestEntries>
                    <!-- MacWindowAppearance calls the Objective-C runtime through the FFM
                         API; without this, JDK 24+ prints a restricted-method warning on
                         every launch. -->
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
